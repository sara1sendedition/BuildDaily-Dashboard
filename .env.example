# Required for transcription + LLM (get a key at https://platform.openai.com/)
OPENAI_API_KEY=

# Subpath when the app is not served at domain root (e.g. `/my-app`). next.config.ts reads this
# and sets `basePath` automatically; `clientApiPath()` uses the same value for `/api/*` fetches.
# NEXT_PUBLIC_BASE_PATH=/my-app

# Set to true to run without OpenAI (stub transcript + stub slides; for UI testing only)
# USE_STUB_LLM=true

# Max video upload size for API routes (megabytes, 1–2000, default 500). Enforced while streaming to disk.
# MAX_UPLOAD_MB=500

# Carousel ZIP: face-aware framing (BlazeFace on each slide timestamp). Set to 0 for legacy center-crop only.
# First carousel job downloads model weights (outbound HTTPS). Background-still carousels skip detection.
# CAROUSEL_FACE_CROP=0

# Optional: URL of the separate “Video to Short” app (Vite default http://localhost:5173). Shown as a nav link; opens in a new tab.
# NEXT_PUBLIC_VIDEO_TO_SHORT_URL=http://localhost:5173

# Video to Short **API** (FastAPI, default port 8000). The studio proxies here so one upload runs Short → carousel → image post.
# Default Short options from the studio include AI editorial + bookend zoom; the Short backend needs OPENAI_API_KEY there for editorial + hook + captions.
# VIDEO_TO_SHORT_API_URL=http://127.0.0.1:8000
# Override Short audio processing without rebuilding (Coolify). If unset, the proxy defaults to `deepfilter` (matches the Short API). Use `fast` for light FFmpeg cleanup or `original` for passthrough.
# VIDEO_TO_SHORT_AUDIO_MODE=deepfilter
# Build-time fallback if server env is unset (less ideal for secrets-heavy hosts).
# NEXT_PUBLIC_VIDEO_TO_SHORT_AUDIO_MODE=fast
# Set to false to skip Short and use the raw upload for carousel/image only.
# VIDEO_TO_SHORT_INTEGRATION=false
# Client-only: skip calling Short (useful if the Python API is not running).
# NEXT_PUBLIC_SKIP_VIDEO_TO_SHORT=1

# Instagram only: Meta often returns (#3) whitelist if scheduled_publish_time is sent unless your app is allowlisted.
# Leave unset/false — use Facebook-only for scheduled calendar sends, or publish IG without a future time.
# META_INSTAGRAM_NATIVE_SCHEDULE=true

# Dev server port (match `npm run dev -- -p …`). publish-due.sh curls this port for scheduled posts.
# NEXT_PORT=3002

# macOS launchd daemon: same secret for server + browser (local dev only — do not deploy NEXT_PUBLIC_* publicly).
# SCHEDULE_DAEMON_SECRET=your-long-random-string
# NEXT_PUBLIC_SCHEDULE_DAEMON_SECRET=your-long-random-string

# YouTube (Short MP4 publish from “Publish now…”): OAuth web client + refresh token. Open /api/youtube/auth once, copy token from callback HTML.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_YOUTUBE_REFRESH_TOKEN=
# Must match Google Cloud “Authorized redirect URIs” (default below if you use port 3002).
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3002/api/youtube/callback

# BuildDaily Hub — Video Studio (StoryTrack)
# NEXT_PUBLIC_STORYTRACK_URL=http://localhost:3000
# STORYTRACK_API_URL=http://localhost:3000
# HUB_STORYTRACK_SECRET=
# HUB_STORYTRACK_USER_ID=

# BuildDaily Hub — Comment Converter
# NEXT_PUBLIC_COMMENT_INBOX_URL=http://localhost:3010
# COMMENT_INBOX_API_URL=http://localhost:3010
# HUB_COMMENT_INBOX_SECRET=

# BuildDaily Hub — Unified Postgres (Coolify-hosted)
# Local dev / migrations run from your Mac use the PUBLIC URL via Coolify Public Proxy.
# The hub container running inside Coolify uses the INTERNAL URL (different hostname).
# DATABASE_URL=postgres://postgres:PASSWORD@135.181.111.234:PORT/postgres

# ──────────────────────────────────────────────────────────────────────────
# Bunny.net storage (added Phase 2b)
# Provision in your Bunny dashboard:
#   - Stream library named "builddaily-videos"
#   - Storage zone named "builddaily-files" in FSN1 (closest to Hetzner)
# Set the resulting values as Coolify env vars on the hub service.
# ──────────────────────────────────────────────────────────────────────────
# BUNNY_STREAM_LIBRARY_ID=
# BUNNY_STREAM_API_KEY=
# BUNNY_STREAM_PULL_ZONE_HOSTNAME=vz-xxxxx.b-cdn.net
# BUNNY_STORAGE_ZONE_NAME=builddaily-files
# BUNNY_STORAGE_ACCESS_KEY=
# BUNNY_STORAGE_HOSTNAME=storage.bunnycdn.com
# BUNNY_STORAGE_PULL_ZONE_HOSTNAME=builddaily-files.b-cdn.net

# ──────────────────────────────────────────────────────────────────────────
# Clerk satellite domains (added Phase 2c, for Studio + CC subdomains)
# The hub itself is the PRIMARY Clerk domain. Studio (studio.builddaily.app)
# and CC (cc.builddaily.app) get satellite config in THEIR repos' .env files.
# This block lives here as a reference for the hub-side encryption key only.
# ──────────────────────────────────────────────────────────────────────────
# CONNECTION_TOKEN_KEY=long-random-base64-string-min-32-bytes
